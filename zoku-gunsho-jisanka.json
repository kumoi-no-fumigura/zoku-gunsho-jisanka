 ],
 "poems": [
  {
   "seq": "1",
   "text": "桜さくとを山鳥のしたりおのなか〳〵し日もあかぬいろかな",
   "kana": "",
   "speaker": "後鳥羽院御製",
   "page": 1,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "2",
   "text": "露は初にもの思ふうろはさそなせく必秋のならひならねと",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "3",
   "text": "おもひ出るおりたく柴の夕けふりむさふもうれしとすれかたみに",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "4",
   "text": "なき人のかた見の雲也時雨らん夕の雨にいろははえねと",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "5",
   "text": "見るましに山風あらく時雨るめり都も今や夜寒なるらん",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "6",
   "text": "我こひはまきの下葉にもる時雨ふるとも袖の色に出めや",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "7",
   "text": "袖の露もあらぬ国にて消かへるうつれはかはるなけさせしまに",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "8",
   "text": "なかめはや神路の山に雲消て夕の空にいてんつさかけ",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "9",
   "text": "大空にこきるゝ頃のとし給へぬ月日もうけよ行末のそら",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "10",
   "text": "みつかきや我代のほしめ契を記しそのことの葉を神やはらはむ",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "11",
   "text": "山ふかみ春ともしらぬ松の戸にたえ〳〵かゝる雪のまま",
   "kana": "",
   "speaker": "式子内親王",
   "page": 2,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "12",
   "text": "なかめわかすぬ秋よりほかはやともかな野にも山にも月や澄らん",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "13",
   "text": "なかめつるけふは昔に成ぬとも軒はの梅をわするな",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "14",
   "text": "きりの葉もふみわけかたく成てけりみならす人を待となはれと",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "15",
   "text": "君まつとねやへもいらぬ橋の戸にいたく飢不叶其山のその月",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "16",
   "text": "夢にてもみゆらん物をなけきつゝうちぬるまひの袖のけしきは",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "17",
   "text": "玉の緒にたえんは南えねなかしへはしのふることのよはりもそする",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "18",
   "text": "いすきてはうちなけ高ゝ夕夕哉我のとしりて過る月日を",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "19",
   "text": "いきてよもあすまて人はつゝからし此夕くれをとはゝ上へかし",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "20",
   "text": "それなからむかしにもあらぬ私風にいとゝなかめを賤のそたまき",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "21",
   "text": "みよし野は山も尋えて出雲のふりにし星は春はきにけり",
   "kana": "",
   "speaker": "後京極摂政太政大臣",
   "page": 2,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "22",
   "text": "天の戸をおしあけ方の雲間より神代の月の影そさやけき",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "23",
   "text": "雲はみなはらひ終たる船風を松にのこして月をみるか南",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "24",
   "text": "我なみるもとめて初にやとれ月さりとて人の願はみえねと",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "25",
   "text": "いつもきく物とや人の思ふらん来ぬ夕暮のまつ風の声",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "26",
   "text": "忘れしと契りて出しおもかけはみゆらんものを古郷の月",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "27",
   "text": "いはさりきのこんまての空の雲月日通畳ゝ物おもへとは",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "28",
   "text": "めくりあはむかきりはいつとしらねとも月なへそ春の後にて",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "29",
   "text": "人すまぬ不破の関屋の梅むさしあれにし後はたくあきの風",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "30",
   "text": "春日山みやこの南しかそ思ふ北の藤なみはるにあへとは",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "31",
   "text": "いつまてか浅くもして月は見し永待えても私そ恋しき",
   "kana": "",
   "speaker": "慈鎮和尚",
   "page": 3,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "32",
   "text": "木の葉ちる宿にかたしく袖の色を臺ともしらてゆくあし哉",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "33",
   "text": "野辺の露は風もなくてやこほれつる袖より過る萩の上風",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "34",
   "text": "霜さゆる山田のはしの村薄よる人なしにのころ哉",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "35",
   "text": "をかのへの里のあるしを尋ぬれは人はこたえす山おろしの風",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "36",
   "text": "おもふことなとくふ人のなからんあふけは空に月きさやけき",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "37",
   "text": "おしなへて日吉のかけはくもらぬに涙あやしきまのふけふ哉",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "38",
   "text": "世の間のはれゆく空にふる霞の我身ひとつそをき所なせ",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "39",
   "text": "山さとに契し広やあれぬらんまたれんとたに思はさりを",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "40",
   "text": "我事のむ七の社のゆふたすきかけてもこの道にかへすな",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "41",
   "text": "みしまいや霜もまたひぬあしの葉につのくむほとの書風そ吹",
   "kana": "",
   "speaker": "後久我内大臣",
   "page": 3,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "42",
   "text": "むさし野也ゆけとも秋のはてそなきいかなる風の末も吹らん",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "43",
   "text": "明ぬとて野へより山に入鹿のあとふきおくるはきの下かせ",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "44",
   "text": "明ほのや川瀬の波のたこそ船くたする人のそての船きり",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "45",
   "text": "嶺こえて雲につはさやしほるゝん月にほすてふはつかりあ声",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "46",
   "text": "さらに又暮をたのめと明にけり月ははれなれあきの夜の空",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "47",
   "text": "詠わすぬそれとはなしに物そ思ふ雪のはたこの夕くれの空",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "48",
   "text": "かきりあれきゑの山のふもとにもおち葉かうへに寄ていろつく",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "49",
   "text": "浅き生や袖に朽にし秋の霜呆れぬ夢をとふあらしかな",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "50",
   "text": "なをてゝせ代々にかはらぬ田山あふく峰よりいつる月かけ",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "51",
   "text": "梅の花誰か袖ふれしにほひそと春やむかしの月にとはゝ也",
   "kana": "",
   "speaker": "兄歟",
   "page": 4,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "52",
   "text": "あはれ又いかにしのはん袖の歌野原の風に船は来にけり",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "53",
   "text": "影やとす露のよすかの船くれて月にこみけるをのゝ篠はら",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "54",
   "text": "野辺におく露の名残もしのはれすあたなる秋の忘れかたみに",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "55",
   "text": "霜むすに袖のかたしきうちとけてねぬよの月の影そのこれる",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "56",
   "text": "水の夜の声にならひし杉の屋の時雨のうへにあられふるなり",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "57",
   "text": "霜こほる袖にもかけは残けりつゆよりなれしありあけの内",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "58",
   "text": "木葉ちる時雨やきよふわか袖にもろき浅のいろとみるまて",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "59",
   "text": "いまこんと契りし事は夢なから見し夜に似たる有明の月",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "60",
   "text": "せきかへし猶もる袖の酒かなしのふをよ所のこゝろならぬに",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "61",
   "text": "むかし思ふ草のいほりのまるの雨はなみてななたへそ山ほとゝきす",
   "kana": "",
   "speaker": "俊成卿",
   "page": 4,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "62",
   "text": "忘しよいするなとたにいひてまし雲井の月の心ありせは",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "63",
   "text": "しめをきていまはとおもふ船山のよもきか本におむしのなく",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "64",
   "text": "いかにして袖に光のやとるらん雲井の月はへるてこし身を",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "65",
   "text": "嵐ふく峰の霧ちの日にそへてもちく成行我儀かなし",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "66",
   "text": "仙人の折袖にほふ茶の露うちはらふにも千世は経ぬへし",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "67",
   "text": "難波人あし火たくやに岩かりてすゝろに袖のしほたるしかな",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "68",
   "text": "稀に来る夜半もかなしき松かせをたえす也亥の下にまくらん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "69",
   "text": "ちらすなよしのゝ葉草のかりにても露からくき袖のうへかは",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "70",
   "text": "立かへり又も来てみむ松嶋やおしまのとまや波にあらすな",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "71",
   "text": "梅花あかぬ色香もむかしにておなしかゝみの音の夜のつき",
   "kana": "",
   "speaker": "俊成卿女",
   "page": 5,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "72",
   "text": "面影のかする月にやとりける春やむかしの袖のなみ事に",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "73",
   "text": "あるにある処の枕にふしいひて鶴なくなり床上風",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "74",
   "text": "いにしへの秋の空まてすみたつ月に事とふ袖のつゆかな",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "75",
   "text": "おしむとて涙に月も心からなれぬる袖に秋をうらみて",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "76",
   "text": "色かける露をは袖にをきまよひうらはれて行野への船哉",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "77",
   "text": "霜かれはそこともしらす草の原誰にとはまし船の名浅を",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "78",
   "text": "ふりにけり時雨は袖に船かけていひしはかりをまつとせしまに",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "79",
   "text": "下もゑに思ひきえなむけふりたにあとなき雲のはてそ悲しき",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "80",
   "text": "夢かとよ見し面かけも契りしも忘すなからうつゝならねは",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "81",
   "text": "かきくらしなをふる里の雪の内に跡こそ見えね音は来にけり",
   "kana": "",
   "speaker": "女房宮内卿",
   "page": 6,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "82",
   "text": "花さそふひらの山かて吹にけり漕ゆく船のあとみゆるまて",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "83",
   "text": "かたえさすおふの浦梨子はつ秋になりもならすも風そ身にしむ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "84",
   "text": "心あるをしまのあまのたもと哉月やとれとはぬれぬものから",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "85",
   "text": "月をなをまつらんものゝ村雨のはれ行雲のすゑのせと人",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "86",
   "text": "霜をまつ籬の菊のよひの間にをきりかふ笛也山のはの月",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "87",
   "text": "立田川あらしや峰によはるらんわたらぬ水もにしきたえけり",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "88",
   "text": "からにしき船のかたみや立田山散あへぬ枝にあらしいなり",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "89",
   "text": "まとろりてなかめよとてのすさひ或床のさ衣月にうつこゑ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "90",
   "text": "肉やいかにうはの空なる風雨にも松にあとするならひありとは",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "91",
   "text": "麦の夜の夢のうきはしとにえして嶺に別るゝは雲のそら",
   "kana": "",
   "speaker": "定家に",
   "page": 6,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "92",
   "text": "駒とめて袖うちはらふ陰もなしさのゝ渡りの雲の夕くれ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "93",
   "text": "松か根をいそへの波のうつたへにあらはれぬへき袖のうへかな",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "94",
   "text": "年もへぬ新契ははつせ山おのへの鐘の鐘のよそのゆふくれ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "95",
   "text": "かへるさの物とや人の思ふらんまつ夜なからのありあけの月",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "96",
   "text": "あちきなくつらき嵐の恋もうしなと夕くれに待ならひけん",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "97",
   "text": "消侘ぬうつろふ人の船の分に身をこからしの杜の下露",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "98",
   "text": "たまゆらの露も隙もとゝまらすなき人恋る也とのあき風",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "99",
   "text": "いつくにかこよひは宿せかり衣日もゆふくれの峰のあらしに",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "100",
   "text": "袖にふけさもな旅ねの夢も見し思かたよりかよふうら風",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "101",
   "text": "朝日頼にほへる山のさ九郎花つれなく消ぬゆきかとそ見る",
   "kana": "",
   "speaker": "有家朝臣",
   "page": 7,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "102",
   "text": "来ぬ秋のいつ暮はてゝ薄氷むすふはかりの山の井の水",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "103",
   "text": "一大陸の月にうらみてかへる波松はつゝくもあらしふく夜に",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "104",
   "text": "行年を小嶋のあまのぬき衣尋ねて袖に波やかくらむ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "105",
   "text": "たひ衣かへす夢ちはむなしくて月とそみるありあけの空",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "106",
   "text": "一岩かねの床にあらしをかたしきてひとりやねなむよの中山",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "107",
   "text": "花をのみおしみなれたるみよし野の梢におつるあり明の月",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "108",
   "text": "物思はてたゝ大かたの露にたにぬけれはぬるゝ船の事もとを",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "109",
   "text": "我なのらおもふか物をとはかりに袖にしくるし庭のまつ風",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "110",
   "text": "春雨のあすねき御代を契る哉霜にかれ行草葉もらすな",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "111",
   "text": "桜花夢かにつゝかしら雲の事えてつれなきみねの春かせ",
   "kana": "",
   "speaker": "家隆朝臣",
   "page": 7,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "112",
   "text": "いかにせんこふ夜あまたのことゝきすまたしとすれは村雨の空",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "113",
   "text": "昨日雨にとはんとおもひし風の国のいく田のもりに船は来にけり",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "114",
   "text": "なかめつら思ふもさひし久かたの月の都のあけかたの空",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "115",
   "text": "下もみちかつちる山の夕時雨ぬれてやし日のひとり鳴らん",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "116",
   "text": "おもひ入身は深草の船の露たのめし末也木からしのかせ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "117",
   "text": "思ひ出とたからねことの末ならん昨日のくものおとの山風",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "118",
   "text": "あけは又御ゆへき山の嶺なれや空行月の末の白雲",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "119",
   "text": "わかの浦や興津しほあひてうかひ出るあはれ我身のよへさし世よ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "120",
   "text": "その山とちさしぬ月も船風もすむる袖につゆそこほるゝ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "121",
   "text": "白雲のたゝ也さてなひく青柳のかつらき山にはる風そふく",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "122",
   "text": "たつねきて花にくらせる木の間より待としもなき山のその月",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "123",
   "text": "たえてやは思ひありともいかゝせんむくらの宿の秋のゆふ暮",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "124",
   "text": "はらすかねこゝこそ露のしけからめやとるか月の初のをはきに",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "125",
   "text": "うつり行寒に嵐の意すなりちるか正木のかつらきの山",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "126",
   "text": "秋の花をはらひはてゝや久かたの月のかつらに木からしの風",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "127",
   "text": "いたつらに立やあさまのゆふけふりさと問かぬるそちこ地の山",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "128",
   "text": "なれ〳〵て見しは名残の音かともなと白川の花の下陰",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "129",
   "text": "君か代にあへるはかりの道はあれと身をは身のます行き也",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "130",
   "text": "草枕むすすさためむかたしらすならはぬ野へのゆめの通路",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "131",
   "text": "一時しもあれたのむの雁の刻さへ花ちるころのみよしのゝ星",
   "kana": "",
   "speaker": "具観",
   "page": 8,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "132",
   "text": "なにはかたかすまぬ時も霞みけりうつるもくもるおほろ月夜に",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "133",
   "text": "しき事えの枕のうへに愚ぬなり露をたつぬる秋のはつかそ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "134",
   "text": "月の夜は名のみそよはのもしほくさかくかきたえて見る夢もなし",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "135",
   "text": "はれくもるかけを都にさきたくしくるとつくり山のはのつき",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "136",
   "text": "今は又あらてもまかふ時雨花頃とりふりゆく庭のまつかせ",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "137",
   "text": "とをさかる雲井のかりの名残さへかすめはつらきなには江の月",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "138",
   "text": "又もかくうきて世にためし有せたゝよふ雲のあとのむら雨",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "139",
   "text": "なかめよとおもはてしもやかへる晩月徳からのあまのつり船",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "140",
   "text": "木あらしよいかに待えむみりの山つれなき松のゆきおれの声",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "141",
   "text": "〽いまはとてたのむのかりもうちわれぬおほろ月夜の明ほのゝ空",
   "kana": "",
   "speaker": "寂蓮法師",
   "page": 9,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "142",
   "text": "かつらまやたかまの桜さきにけり立田のおくにかゝかしら雲",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "143",
   "text": "物思ふ袖より露やならひけん私風ふけはたゝはぬものとは",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "144",
   "text": "むら雨の露もまたひぬ松の葉に骨たちのほるあきの夕くれ",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "145",
   "text": "さひしさは其色としもなかりけり橋立山の私のゆふくれ",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "146",
   "text": "思ひあれは袖にほたるをつゝみてもいはらや物を問人はなし",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "147",
   "text": "老の波こえける身こそあわれなれ今年もいまはすゑの松山",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "148",
   "text": "からみ侘またし今はの身なれとも思なれにし夕くれの空",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "149",
   "text": "さとはあれてむなしき床のあたりまて身はならはしの紅風そ吹",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "150",
   "text": "月の行山にこゝろを越くりいれて関なる跡の身をいかにさむ",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "151",
   "text": "夕附夜しほみちくらしなにはへのあしの紅葉をこゆるしら波",
   "kana": "",
   "speaker": "藤原秀能",
   "page": 9,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "152",
   "text": "あしひきの山路の吉の露のうへに読め夜ふかき月をみるかな",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "153",
   "text": "山里のかをすさましき夕くれに木の葉みたれて物そ悲しき",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "154",
   "text": "草枕夕への空を人とはゝなき身もつけよはつかりのこゑ",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "155",
   "text": "下紅葉うつろひ行は玉ほこのみちの山かせさむく吹らし",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "156",
   "text": "もしほやく流士の塩屋の夕煙たつ名もくるしおもひ事元なき",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "157",
   "text": "袖のうへに誰ゆへ月はやとるそとま所になしても人のとへかし",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "158",
   "text": "いまこんと契しことをわすれすはこの夕暮のつきやますへん",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "159",
   "text": "つゆせたに今は形見のふち衣あるにも袖をふくあらし赤",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "160",
   "text": "月すめは四方のうき雲からに消てみ山かくれに跡あらし哉",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "161",
   "text": "吉野山されらか枝に雲敷て花をうけなる年もあるかな",
   "kana": "",
   "speaker": "西行法師",
   "page": 10,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "162",
   "text": "よしの山やかて出しと思ふ身を花散なはと人やまつらむ",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "163",
   "text": "詠とも花にもいたくなれぬれはちるわかれこそかなしかりけれ",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "164",
   "text": "あはれいかに草葉の歌のこほる覧秋風たちぬみやきのゝ原",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "165",
   "text": "月見はと契て出し古郷の人もや水夜そてぬらすし角",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "166",
   "text": "きむらす夜寒に船の成まゝによはるかこゑの遠さかり行",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733547",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
